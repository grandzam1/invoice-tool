rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Invoices collection for public visual invoice CMS without authentication
    match /invoices/{invoiceId} {
      allow read: if true;
      allow create: if request.resource.data.id is string
                    && request.resource.data.id.size() <= 128
                    && request.resource.data.number is string
                    && request.resource.data.client_name is string;
      allow update: if request.resource.data.id is string
                    && request.resource.data.id == resource.data.id;
      allow delete: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
